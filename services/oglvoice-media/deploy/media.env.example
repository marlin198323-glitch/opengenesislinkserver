# EXAMPLE ONLY. Copy to /etc/oglvoice/media.env (chmod 0600; owner oglvoice).
# Use the ACTUAL simulator [NexVerseNodeAgent] NodeId and SharedKey values.
# The first-party tenant has unlimited sessions, by deliberate server policy.
OGLVOICE_MEDIA_BIND=127.0.0.1:19098
OGLVOICE_LIVEKIT_URL=ws://127.0.0.1:7880
OGLVOICE_LIVEKIT_API_KEY=REPLACE_WITH_OGLVOICE_API_KEY
OGLVOICE_LIVEKIT_API_SECRET=REPLACE_WITH_LONG_RANDOM_LIVEKIT_SECRET
OGLVOICE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
OGLVOICE_WEBRTC_PORT_MIN=40000
OGLVOICE_WEBRTC_PORT_MAX=40999
OGLVOICE_MEDIA_ACL_JSON='{"nodes":{"REPLACE_WITH_REAL_NODE_ID":{"secret":"REPLACE_WITH_REAL_NEXBUS_SHARED_KEY_MINIMUM_32_BYTES","tenant":"opengenesislink"}},"tenants":{"opengenesislink":{"max_sessions":0,"max_regions":0}}}'
