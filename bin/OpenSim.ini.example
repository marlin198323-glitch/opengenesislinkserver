; OpenGenesisLINK 0.9.3.10 compact simulator INI
; Active overrides only. Defaults in OpenSimDefaults.ini / config-include/*.ini.
; Runtime secrets and instance state must not be committed.

[NexVerseNodeAgent]
    Enabled = true
    NodeId = ""
    PeerUrl = "${Environment|NEXVERSE_NEXBUS_PEER_URL}"
    SharedKey = "${Environment|NEXVERSE_NEXBUS_SHARED_KEY}"
    InboundPath = "/internal/nexbus/v1/events"
    HeartbeatSeconds = 30
    QueueCapacity = 2048
    RequestTimeoutMilliseconds = 2000
    DeduplicationWindow = 10000
    CrossRegionObjectMessaging = true
    CrossRegionChatMessaging = true
    AllowCrossOwnerObjectMessages = true
    EstateScriptMessaging = true
    ObjectMessagesPerSecond = 20
    ObjectMessageMaxAgeSeconds = 30
    ManagedRegionCommands = false
    ManagedRegionConfigDirectory = "Regions/NexVerseManaged"
    ManagedRegionInternalAddress = "0.0.0.0"
    ManagedRegionExternalHostName = ""
    ManagedRegionType = "NexVerse Managed"
    ManagedRegionPortMin = 9300
    ManagedRegionPortMax = 9399

[OpenGenesisLINKOAR]
    Enabled = true
    StorageRoot = "OGLArchives"
    MaximumArchiveMiB = 20480
    MigrationStorageId = ""

[Const]
    BaseHostname = "127.0.0.1"
    BaseURL = http://${Const|BaseHostname}
    PublicPort = "9000"
    PrivURL = ${Const|BaseURL}
    PrivatePort = "8003"

[Startup]
    ; IAR-Fortschritt live neben der lokalen Konsolen-Eingabe anzeigen.
    ; Remote-Konsole: show iar progress (manuelle Live-Abfrage).
    OGLIarLiveProgress = true
    meshing = Meshmerizer
    physics = BulletSim
    EnableCertConverter = false
    PemCertPublicKey = ""
    PemCertPrivateKey = ""
    outputCertName = "letsencrypt"
    outputCertPassword = ""
    EnableSelfsignedCertSupport = false
    CertRenewOnStartup = false
    CertFileName = "OpenSim"
    CertPassword = "mycertpass"
    CertHostName = "myRegionsExternalHostName"
    CertHostIp = "127.0.0.1"

[AccessControl]

[Map]
    GenerateMaptiles = true
    MapImageModule = "Warp3DImageModule"
    TextureOnMapTile = true
    DrawPrimOnMapTile = true
    TexturePrims = true
    RenderMeshes = true

[Permissions]
    automatic_gods = false
    implicit_gods = false
    allow_grid_gods = true

[Estates]

[SMTP]

[Network]
    http_listener_port = 9000
    ExternalHostNameForLSL = ${Const|BaseHostname}
    shard = "OpenSim"

; Port 0 selects a free TCP port when Enabled=true.
[NexVerseAutoPorts]
    Enabled = false
    HttpPortMin = 9000
    HttpPortMax = 9099

[XMLRPC]
    XmlRpcRouterModule = "XmlRpcRouterModule"
    XmlRpcPort = 20800

[ClientStack.LindenUDP]

[ClientStack.LindenCaps]
    Cap_GetTexture = "localhost"
    Cap_GetMesh = "localhost"
    Cap_AvatarPickerSearch = "localhost"
    Cap_GetDisplayNames = "localhost"
    Cap_SetDisplayName = "localhost"

[SimulatorFeatures]
    SearchServerURI = "https://stadt-nexverse.de/service/search?q=[QUERY]&type=[TYPE]&maturity=[MATURITY]"
    DestinationGuideURI = "https://stadt-nexverse.de/service/destination"

[Chat]

[EntityTransfer]

[Messaging]
    OfflineMessageModule = "Offline Message Module V2"

[OfflineIMEmail]
    Enabled = true
    RelayDomain = "im.stadt-nexverse.de"
    SubjectTemplate = "Offline-IM Nachricht von {SENDER}"
    RelaySigningKey = "${Environment|NEXVERSE_IM_RELAY_SIGNING_KEY}"
    ReplyLifetimeDays = 5
    SMTPHost = "mail.nexvortex.de"
    SMTPPort = 587
    UseStartTls = true
    UseSslOnConnect = false
    SMTPUsername = "relay@im.stadt-nexverse.de"
    SMTPPassword = "${Environment|NEXVERSE_OFFLINE_IM_SMTP_PASSWORD}"
    PerSenderPerHour = 30
    PerRecipientPerHour = 60
    GlobalPerHour = 500

[BulletSim]
    AvatarToAvatarCollisionsByDefault = true

[Wind]

[Materials]

[DataSnapshot]

[Economy]
    economymodule = NexVerseMoneyModule

; OGL Viewer Advisor: opt-in recommendation for users of other viewers.
; The module is intentionally disabled until explicitly enabled.
[OGLViewerAdvisor]
    Enabled = false
    IntervalMinutes = 60
    OfficialViewerPrefixes = "OpenGenesisLINK;OGL Viewer"
    Message = "Um das volle Erlebnis von OpenGenesisLINK geniessen zu koennen, steigen Sie auf den offiziellen OGL Viewer um: https://opengenesislink.de"

[NexDiscoveryViewer]
    Enabled = true
    LegacyFirestormCompatibility = true
    WorldApiBaseUrl = "${Const|BaseURL}:${Const|PublicPort}"
    ; Dedicated backend-only groups:read machine key, created in the World API.
    ; Without it, the Firestorm group land tab sees local simulator regions only.
    GroupLandApiKey = "${Environment|NEXVERSE_GROUP_LAND_API_KEY}"
    RequestTimeoutMilliseconds = 3000

[NexExperiencesViewer]
    ; 0.9.3.10 stabilization: Firestorm Experiences are not released.
    ; Preserve implementation/tests but do not advertise viewer CAPS or consent.
    ; A later own-viewer 2.0 scope may be explicitly planned.
    Enabled = false
    WorldApiBaseUrl = "https://world.stadt-nexverse.de"
    ApiKey = "${Environment|NEXVERSE_EXPERIENCES_API_KEY}"
    RequestTimeoutMilliseconds = 3000
    FirestormReadCaps = true
    FirestormPermissionCaps = true
    ScriptPendingConsent = true
    NativeExperiencePrompt = true
    ViewerPermissionsApiKey = "${Environment|NEXVERSE_EXPERIENCES_VIEWER_PERMISSIONS_API_KEY}"
    FirestormManageCaps = true
    ViewerManageApiKey = "${Environment|NEXVERSE_EXPERIENCES_VIEWER_MANAGE_API_KEY}"

[NexEconomyViewer]
    Enabled = true
    WorldApiBaseUrl = "https://world.stadt-nexverse.de"
    ApiKey = "${Environment|NEXVERSE_ECONOMY_API_KEY}"
    FeeWalletId = ""
    UploadCharge = 0
    GroupCreationCharge = 0
    RequestTimeoutMilliseconds = 3000
    BalanceRefreshSeconds = 5
    ; Enable NV$ wallets for authenticated Hypergrid visitors. No foreign-grid currency transfer.
    AllowHypergridGuests = true
    MasterBankEnabled = false
    MasterBankAccountId = ""
    MasterBankOperatorId = ""
    MasterBankAuthorizedScripts = ""
    MasterBankMaxPayout = 100
    CurrencyPurchasePortalUrl = ""

[YEngine]

[XEngine]
    AppDomainLoading = false

[NexPortalIM]
    Enabled = false
    ; When ROBUST and Simulator are separate hosts use the protected HTTPS proxy path.
    IngestUrl = "https://world.stadt-nexverse.de/internal/nexportal/im/v1"
    SharedSecret = "${Environment|NEX_PORTAL_IM_SECRET}"

[OSSL]
    Include-osslDefaultEnable = "config-include/osslDefaultEnable.ini"

[Groups]
    Enabled = true
    Module = "Groups Module V2"
    ServicesConnectorModule = "Groups HG Service Connector"
    LocalService = remote
    GroupsServerURI = "${Const|PrivURL}:${Const|PrivatePort}"
    MessagingEnabled = true
    MessagingModule = "Groups Messaging Module V2"
    NoticesEnabled = true
    MessageOnlineUsersOnly = true

[InterestManagement]

[MediaOnAPrim]

[NPC]

[Terrain]

[LandManagement]

[UserProfiles]
    ProfileServiceURL = ${Const|BaseURL}:${Const|PublicPort}

[FirestormBridge]
    Enabled = true

[Appearance]
    PersistBakedTextures = true
    ReuseTextures = true
    DelayBeforeAppearanceSend = 1
    DelayBeforeAppearanceSave = 3
    ResendAppearanceUpdates = false

[XBakes]

[Architecture]
    Include-Architecture = "config-include/Standalone.ini"


; ================================================================
; OpenGenesisLINK Feature Control 1.0 - standardmäßig aktiviert
; ================================================================
[OGLFeatureControl]
    ; ES256-Schlüssel auf ROBUST und Simulatoren bereitstellen!
    ; Ohne Schlüssel scheitert der ROBUST-Start; ohne signierte Richtlinie
    ; sperrt der Simulator OAR-/IAR-Operationen (fail-closed).
    Enabled = true
    ; Simulator erhält NUR den öffentlichen ES256-Prüfschlüssel.
    ; Alternativ OGL_FEATURE_PUBLIC_KEY_PEM in der Prozessumgebung setzen.
    PublicKeyPath = "config-include/ogl-feature-public.pem"
    ; NodeID muss zur NodeAgent-NodeId passen.
    ; Zusätzlich NexVerseNodeAgent Enabled=true mit authentifiziertem
    ; NexBus und erreichbarem Robust-Peer konfigurieren.


; Anzeigeoptionen unter [Startup]:
; OGLConsoleGermanHelp = true
; OGLConsoleExpertHelp = false
