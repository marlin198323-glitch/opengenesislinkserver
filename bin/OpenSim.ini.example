; OpenGenesisLINK 0.9.3.10 - bereinigte Simulator-Konfiguration
; Allgemeines Standalone-Beispiel (statischer HTTP-Port).
; Nur wirksame Overrides; Standardwerte stehen in OpenSimDefaults.ini
; sowie config-include/*.ini. API-Secrets niemals im Git speichern.
; Lokale Betreiberdateien vor einem Update getrennt sichern.

; Authenticated NexBus agent. Configure protected peer and secrets.
[NexVerseNodeAgent]
    Enabled = true
    NodeId = ""
    PeerUrl = "${Environment|NEXVERSE_NEXBUS_PEER_URL}"
    SharedKey = "${Environment|NEXVERSE_NEXBUS_SHARED_KEY}"
    InboundPath = "/internal/nexbus/v1/events"
    HeartbeatSeconds = 30
    QueueCapacity = 2048
    RequestTimeoutMilliseconds = 2000
    DeduplicationWindow = 10000
    CrossRegionObjectMessaging = true
    AllowCrossOwnerObjectMessages = true
    EstateScriptMessaging = true
    ObjectMessagesPerSecond = 20
    ObjectMessageMaxAgeSeconds = 30
    ManagedRegionCommands = false
    ManagedRegionConfigDirectory = "Regions/NexVerseManaged"
    ManagedRegionInternalAddress = "0.0.0.0"
    ManagedRegionExternalHostName = ""
    ManagedRegionType = "NexVerse Managed"
    ManagedRegionPortMin = 9300
    ManagedRegionPortMax = 9399

; Managed OAR archive storage and guarded migrations.
[OpenGenesisLINKOAR]
    Enabled = true
    StorageRoot = "OGLArchives"
    MaximumArchiveMiB = 20480
    MigrationStorageId = ""

; Grid constants; update these values only for the intended deployment.
[Const]
    BaseHostname = "127.0.0.1"
    BaseURL = http://${Const|BaseHostname}
    PublicPort = "9000"
    PrivURL = ${Const|BaseURL}
    PrivatePort = "8003"

; Active startup overrides; disabled certificate conversion uses defaults.
[Startup]
    meshing = Meshmerizer
    physics = BulletSim
    EnableCertConverter = false
    EnableSelfsignedCertSupport = false
    CertRenewOnStartup = false

; Warp3D map tile generation.
[Map]
    GenerateMaptiles = true
    MapImageModule = "Warp3DImageModule"
    TextureOnMapTile = true
    DrawPrimOnMapTile = true
    TexturePrims = true
    RenderMeshes = true

; Explicit administrator permissions.
[Permissions]
    automatic_gods = false
    implicit_gods = false
    allow_grid_gods = true

; Simulator HTTP listener and external hostname.
[Network]
    http_listener_port = 9000
    ExternalHostNameForLSL = ${Const|BaseHostname}
    shard = "OpenSim"

; LSL llRemoteData / XML-RPC. -1 means share this simulator's HTTP listener.
[XMLRPC]
    XmlRpcRouterModule = "XmlRpcRouterModule"
    XmlRpcPort = -1

; Viewer CAPS.
[ClientStack.LindenCaps]
    Cap_GetTexture = "localhost"
    Cap_GetMesh = "localhost"
    Cap_AvatarPickerSearch = "localhost"
    Cap_GetDisplayNames = "localhost"
    Cap_SetDisplayName = "localhost"

; Viewer search and destinations.
[SimulatorFeatures]
    SearchServerURI = "https://world.stadt-nexverse.de/search?q=[QUERY]&type=[TYPE]&maturity=[MATURITY]"
    DestinationGuideURI = "https://world.stadt-nexverse.de/destinations"

; Offline IM persistence.
[Messaging]
    OfflineMessageModule = "Offline Message Module V2"

; Stored offline IM email relay.
[OfflineIMEmail]
    Enabled = true
    RelayDomain = "im.stadt-nexverse.de"
    SubjectTemplate = "Offline-IM Nachricht von {SENDER}"
    RelaySigningKey = "${Environment|NEXVERSE_IM_RELAY_SIGNING_KEY}"
    ReplyLifetimeDays = 5
    SMTPHost = "mail.nexvortex.de"
    SMTPPort = 587
    UseStartTls = true
    UseSslOnConnect = false
    SMTPUsername = "relay@im.stadt-nexverse.de"
    SMTPPassword = "${Environment|NEXVERSE_OFFLINE_IM_SMTP_PASSWORD}"
    PerSenderPerHour = 30
    PerRecipientPerHour = 60
    GlobalPerHour = 500

; Physics collision policy.
[BulletSim]
    AvatarToAvatarCollisionsByDefault = true

; NV$ authoritative economy adapter.
[Economy]
    economymodule = NexVerseMoneyModule

; NexDiscovery directory compatibility.
[NexDiscoveryViewer]
    Enabled = true
    LegacyFirestormCompatibility = true
    WorldApiBaseUrl = "${Const|BaseURL}:${Const|PublicPort}"
    RequestTimeoutMilliseconds = 3000

; Firestorm read, consent, permission, acquire and editor CAPS. Require three DISTINCT scoped API keys from process secrets. Missing keys fail closed.
[NexExperiencesViewer]
    Enabled = true
    WorldApiBaseUrl = "https://world.stadt-nexverse.de"
    ApiKey = "${Environment|NEXVERSE_EXPERIENCES_API_KEY}"
    RequestTimeoutMilliseconds = 3000
    FirestormReadCaps = true
    FirestormPermissionCaps = true
    ScriptPendingConsent = true
    NativeExperiencePrompt = true
    ViewerPermissionsApiKey = "${Environment|NEXVERSE_EXPERIENCES_VIEWER_PERMISSIONS_API_KEY}"
    FirestormManageCaps = true
    ViewerManageApiKey = "${Environment|NEXVERSE_EXPERIENCES_VIEWER_MANAGE_API_KEY}"

; Central NV$ wallet adapter.
[NexEconomyViewer]
    Enabled = true
    WorldApiBaseUrl = "https://world.stadt-nexverse.de"
    ApiKey = "${Environment|NEXVERSE_ECONOMY_API_KEY}"
    FeeWalletId = ""
    UploadCharge = 0
    GroupCreationCharge = 0
    RequestTimeoutMilliseconds = 3000
    BalanceRefreshSeconds = 5
    CurrencyPurchasePortalUrl = ""

; Legacy script engine override.
[XEngine]
    AppDomainLoading = false

; Experimental NPC path follower; disabled.
[OGLNpcNavigation]
    Enabled = false
    MaxActivePerRegion = 32
    MaxWaypoints = 256
    TickMilliseconds = 1000
    WaypointTimeoutSeconds = 45

; OGLVoice optional example for Standalone; no audio service is enabled.
;[OGLVoice]
;    Enabled = false
;    Mode = "Standalone"
;    EnableFirestormGateway = true
; Requires an authenticated compatible media bridge.

; Experimental pathfinding; disabled until isolated test.
[OGLPathfinding]
    Enabled = false
    CellMeters = 4
    MaxSlopePerMeter = 0.65
    MaxExpandedNodes = 20000
    RebuildSeconds = 30
    TrackStaticColliders = false
    StaticAgentHeight = 1.8
    MaxStaticPrims = 20000
    UseVerifiedLayeredSurfaces = false
    LayeredMaxStepMeters = 0.6
    PhysicsRaycastLayeredSurfaces = false
    PhysicsRaycastMaxBuildSeconds = 30
    PhysicsMultiRayClearance = false
    PhysicsVerifiedTransitions = false
    PhysicsAgentHeight = 1.8
    PhysicsAgentRadius = 0.5
    FirestormNavMeshCaps = false
    OpenNavGraphCaps = false

; Optional signed portal IM ingestion; disabled.
[NexPortalIM]
    Enabled = false
    IngestUrl = "http://127.0.0.1/internal/nexportal/im/v1"
    SharedSecret = "${Environment|NEX_PORTAL_IM_SECRET}"

; OSSL permissions use the separate include policy.
[OSSL]
    Include-osslDefaultEnable = "config-include/osslDefaultEnable.ini"

; Grid/Hypergrid groups connector.
[Groups]
    Enabled = true
    Module = "Groups Module V2"
    ServicesConnectorModule = "Groups HG Service Connector"
    LocalService = remote
    GroupsServerURI = "${Const|PrivURL}:${Const|PrivatePort}"
    MessagingEnabled = true
    MessagingModule = "Groups Messaging Module V2"
    NoticesEnabled = true
    MessageOnlineUsersOnly = true

; Profile service URL.
[UserProfiles]
    ProfileServiceURL = ${Const|BaseURL}:${Const|PublicPort}

; Firestorm bridge asset bootstrapping.
[FirestormBridge]
    Enabled = true

; Avatar bake persistence and fast updates.
[Appearance]
    PersistBakedTextures = true
    ReuseTextures = true
    DelayBeforeAppearanceSend = 1
    DelayBeforeAppearanceSave = 3
    ResendAppearanceUpdates = false

; Selected deployment architecture.
[Architecture]
    Include-Architecture = "config-include/Standalone.ini"

; Automatic HTTP ports are enabled for the NexVerse Grid deployment.
; Existing fixed ports always take precedence when http_listener_port != 0.
[NexVerseAutoPorts]
    Enabled = false
    HttpPortMin = 9000
    HttpPortMax = 9099
